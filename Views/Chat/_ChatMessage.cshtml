@model Digital_Krushi_Officer.Models.ViewModels.ChatMessageViewModel
<article class="thread-turn" data-query-id="@Model.QueryId">
    <div class="user-message"><span class="message-author">@Ui.Text("You")</span><p>@Model.QueryText</p>
        @if(Model.ImageUrls.Any()) { <div class="message-photos">@foreach(var image in Model.ImageUrls) { <a href="@image" target="_blank" rel="noopener"><img src="@image" alt="@Ui.Text("Attached crop or soil photo")" loading="lazy" /></a> }</div> }
    </div>
    <div class="assistant-message"><span class="assistant-avatar" aria-hidden="true">✳</span><div class="assistant-content"><div class="assistant-heading"><strong>Krushi AI</strong><span class="answer-tag">@Ui.Text(Model.Status=="RetryNeeded"?"Temporarily unavailable":Model.Status=="AwaitingDetails"?"A little more detail":Model.ApprovalStatus=="AIAnswered"?"AI answer":Model.Status=="Answered"?"Officer reviewed":Model.Status=="PendingApproval"?"Sent to officer":Model.Status)</span></div><div class="answer-text">@(Model.AIAnswer ?? (string.IsNullOrWhiteSpace(Model.PublicSummary) ? "" : Model.PublicSummary + "\n\n") + Ui.Text(Digital_Krushi_Officer.Services.AdvisoryPolicy.PendingMessage(Model.Status)))</div>
    @if(Model.OfficerReply!=null && Model.OfficerReply!=Model.AIAnswer) { <p class="message-author">@Ui.Text("Officer reply")</p><div class="answer-text">@Model.OfficerReply</div> }
    @if(Model.Status=="Answered") { <div class="rating" data-query="@Model.QueryId"><span>@Ui.Text("Was this helpful?")</span>@for(var i=1;i<=5;i++){<button type="button" data-rating="@i" aria-label="@string.Format(Ui.Text("Rate {0} out of 5"), i)">@(Model.FeedbackRating>=i?"★":"☆")</button>}</div> }
    </div></div>
</article>
