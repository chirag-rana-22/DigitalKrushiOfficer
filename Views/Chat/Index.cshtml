@model Digital_Krushi_Officer.Models.ViewModels.ChatViewModel
@{ ViewData["Title"]="Ask your farming question"; ViewData["ActiveMenu"]="Chat"; }
<div class="page-header"><span class="eyebrow">YOUR FARMING CONVERSATION</span><h1>A clearer next step.</h1><p>Ask in Gujarati, Hindi or English. An officer reviews farming advice before it appears here.</p></div>
<div class="chat-shell"><div class="chat-toolbar"><span class="status-dot"></span> Private advisory workspace <a href="/Farmer/QueryHistory">All questions ↗</a></div>
<div id="messages" class="conversation" aria-live="polite">
@if(!Model.Messages.Any()) { <div class="chat-welcome"><span class="eyebrow">LET'S START WITH YOUR FIELD</span><h2>What would you like help with?</h2><p>Include your crop, location, growth stage and what you have noticed.</p><div class="quick-questions"><button type="button" data-question="What details should I record about my crop before asking for advice?">Prepare a crop question</button><button type="button" data-question="How can I monitor changes in my crop leaves?">Observe crop symptoms</button></div></div> }
@foreach(var message in Model.Messages) { <article class="conversation-item"><div class="question-bubble"><small>You · @message.CreatedDate.ToString("dd MMM, HH:mm")</small><p>@message.QueryText</p>@if(message.ImagePath!=null){<img src="@message.ImagePath" alt="Your crop photo" loading="lazy" />}</div><div class="answer-bubble"><span class="badge badge-green">@message.Status</span><p class="answer-text">@(message.AIAnswer ?? Digital_Krushi_Officer.Services.AdvisoryPolicy.PendingMessage(message.Status))</p>@if(message.OfficerReply!=null && message.OfficerReply!=message.AIAnswer){<h4>Officer reply</h4><p class="answer-text">@message.OfficerReply</p>}@if(message.Status=="Answered"){<div class="rating" data-query="@message.QueryId"><span>Was this helpful?</span>@for(var i=1;i<=5;i++){<button type="button" data-rating="@i" aria-label="Rate @i out of 5">@(message.FeedbackRating>=i ? "★" : "☆")</button>}</div>}</div></article> }
</div>
<form id="questionForm" class="composer"><label for="questionText">Your question</label><textarea id="questionText" name="question" rows="3" maxlength="4000" placeholder="Tell us about your crop…"></textarea><div class="composer-actions"><label class="upload-button" for="cropPhoto">＋ Crop photo<input id="cropPhoto" type="file" accept="image/jpeg,image/png,image/webp" /></label><button type="button" id="voiceButton" class="btn-outline-green">Voice input</button><span id="photoLabel" class="text-muted"></span><button type="submit" id="sendButton" class="btn-primary-green">Send for review ↗</button></div><small>Photos up to 5 MB. Check a voice transcript before sending. <a href="/Home/Privacy">How your data is used</a></small><p id="chatStatus" role="status"></p></form>
@Html.AntiForgeryToken()
</div>
@section Scripts { <script src="~/js/chat.js" asp-append-version="true"></script> }
