@model Digital_Krushi_Officer.Models.TblQuery
@{ var photos=Digital_Krushi_Officer.Services.QueryMedia.Paths(Model); }
@if(photos.Count>0) { <div style="display:flex;gap:8px;flex-wrap:wrap;margin:10px 0">@for(var i=0;i<photos.Count;i++) { <a href="@Url.Action("QueryImage","Media",new{id=Model.Id,index=i})" target="_blank" rel="noopener"><img src="@Url.Action("QueryImage","Media",new{id=Model.Id,index=i})" alt="Crop or soil photo @(i+1) of @photos.Count" style="width:120px;height:100px;object-fit:cover;border-radius:10px" loading="lazy" /></a> }</div> }
