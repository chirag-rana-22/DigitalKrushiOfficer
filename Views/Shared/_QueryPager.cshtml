@{ int page = ViewBag.Page ?? 1; bool hasNext = ViewBag.HasNext ?? false; }
<nav aria-label="@Ui.Text("Question pages")" class="d-flex align-items-center gap-3 mt-4">
@if(page>1){<a asp-route-page="@(page-1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.StatusFilter" class="btn-outline-green">@Ui.Text("Previous")</a>}
<span>@Ui.Text("Page") @(page) · @Ui.Text("up to 50 questions")</span>
@if(hasNext){<a asp-route-page="@(page+1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.StatusFilter" class="btn-outline-green">@Ui.Text("Next")</a>}
</nav>

