<form method="get" class="card p-3 mb-4"><div class="d-flex gap-2 flex-wrap"><input name="search" value="@ViewBag.Search" maxlength="200" aria-label="Search questions" class="form-control" style="max-width:360px" placeholder="Search your questions"/><select name="status" aria-label="Query status" class="form-select" style="max-width:220px"><option value="">All statuses</option>@foreach(var status in new[]{"Unassigned","PendingApproval","NeedsRevision","Answered","Escalated","Closed"}){<option value="@status" selected="@(ViewBag.StatusFilter == status)">@status</option>}</select><button class="btn-primary-green">Search</button></div></form>
