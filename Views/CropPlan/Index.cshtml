@model Digital_Krushi_Officer.Models.ViewModels.CropPlanModel
@using Digital_Krushi_Officer.Services
@{ ViewData["Title"] = "Crop calendar"; ViewData["ActiveMenu"] = "Crops"; var crop = Model.Crop; var today = CropPlanning.Today; var language = Ui.Language; }
<div class="page-header"><h1>@Digital_Krushi_Officer.Services.ReminderLanguage.CropName(crop, Ui.Language)</h1><p>@(crop.FieldName ?? Ui.Text("Name your field in Edit details")) · @(crop.Variety ?? Ui.Text("Variety not set")) · @Ui.Text(crop.Status)</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap"><a asp-action="Edit" asp-route-id="@crop.Id" class="btn-outline-green">@Ui.Text("Edit details")</a><a href="/Chat/Index?newChat=true&amp;farmerCropId=@crop.Id" class="btn-primary-green">@Ui.Text("Ask AI about this crop")</a><a asp-action="Today" class="btn-outline-green">@Ui.Text("Today's tasks")</a><a href="/Farmer/Crops" class="btn-outline-green">@Ui.Text("All crops")</a></div>
</div>
<div class="card p-4" style="margin-bottom:20px"><strong>@Ui.Text("Your crop plan")</strong><p>@Ui.Text("Sowing"): @(crop.SowingDate?.ToString("dd MMM yyyy") ?? Ui.Text("Not set")) · @Ui.Text("Estimated harvest"): @(crop.ExpectedHarvestDate?.ToString("dd MMM yyyy") ?? Ui.Text("Not set")) · @Ui.Text("Area"): @(crop.LandArea?.ToString() ?? Ui.Text("Not set")) @Ui.Text("acres")</p>
<p>@Ui.Text("Email reminders:")<strong>@Ui.Text(crop.EmailRemindersEnabled ? "On" : "Off")</strong> · <a asp-action="Edit" asp-route-id="@crop.Id">@Ui.Text("Manage preference")</a></p>
@if (ViewBag.EmailSchedulerEnabled != true) { <p>@Ui.Text("Scheduled email delivery is awaiting setup. Website reminders are available.")</p> }
@if (ViewBag.LatestDigest is Digital_Krushi_Officer.Models.CropDigest digest) { <p>@Ui.Text("Last daily summary"): @digest.LocalDate.ToString("dd MMM yyyy") · @Ui.Text(digest.Status == "Accepted" ? "Accepted by email provider (inbox delivery not confirmed)" : digest.Status == "Failed" ? "Delivery failed; check website tasks" : "Delivery outcome awaiting confirmation; check website tasks")</p> }
@if (crop.HarvestedDate != null) { <p>@Ui.Text("Harvest recorded"): @crop.HarvestedDate.Value.ToString("dd MMM yyyy"). @Ui.Text("No further reminders will be sent for this crop.")</p> }
</div>
<h2>@Ui.Text("Calendar & reminders")</h2><p>@Ui.Text("Due and overdue tasks appear first. Dates use India time. Review actual crop and field conditions before acting.")</p>
@if (!crop.Tasks.Any(t => t.Status == "Pending")) { <p>@Ui.Text("No upcoming tasks. Confirm the suggested calendar or add a reminder below.")</p> }
@foreach (var task in crop.Tasks.Where(t => t.Status == "Pending").OrderBy(t => t.DueDate).ThenBy(t => t.Id)) { <partial name="_Task" model="task" /> }
@if (crop.Status == "Growing") {
<details class="card p-4" style="margin:20px 0"><summary><strong>@Ui.Text("Review suggested calendar — confirm before activating")</strong></summary>
    <p>@Ui.Text("General check-ins only, not a crop-specific fertilizer or pesticide schedule. You can change every date. Past dates will not be added. Confirming replaces only pending suggested tasks; your custom tasks and completed history stay.")</p>
    @if (!Model.Preview.Any()) { <a asp-action="Edit" asp-route-id="@crop.Id">@Ui.Text("Set sowing and estimated harvest dates to create a plan.")</a> }
    else { <ul>@foreach (var task in Model.Preview) { <li>@ReminderLanguage.Date(task.DueDate, language) — @ReminderLanguage.TaskTitle(task, language) @(task.DueDate < today ? "(" + Ui.Text("past — not added") + ")" : "")</li> }</ul><form method="post" asp-action="AcceptPlan"><input type="hidden" name="id" value="@crop.Id" /><button class="btn-primary-green">@Ui.Text("Confirm these reminder dates")</button></form> }
</details>
<div class="card p-4" style="margin:20px 0"><h3>@Ui.Text("Add your own reminder")</h3><form method="post" asp-action="AddTask">
    <input type="hidden" name="id" value="@crop.Id" /><div class="form-group"><label for="title">@Ui.Text("Task")</label><input class="form-control" id="title" name="title" maxlength="160" required placeholder="@Ui.Text("e.g. Check soil moisture")" /></div>
    <div class="form-group"><label for="dueDate">@Ui.Text("Reminder date")</label><input class="form-control" id="dueDate" name="dueDate" type="date" required min="@today.ToString("yyyy-MM-dd")" max="@today.AddYears(2).ToString("yyyy-MM-dd")" /></div>
    <div class="form-group"><label for="notes">@Ui.Text("Notes (optional)")</label><textarea class="form-control" id="notes" name="notes" maxlength="1000"></textarea></div><button class="btn-primary-green">@Ui.Text("Add reminder")</button>
</form></div>
<details class="card p-4"><summary><strong>@Ui.Text("Confirm harvest")</strong></summary><p>@Ui.Text("Only confirm when this crop has actually been harvested. This stops all remaining reminders for this crop.")</p><form method="post" asp-action="ConfirmHarvest"><input type="hidden" name="id" value="@crop.Id" /><label for="harvestedDate">@Ui.Text("Actual harvest date")</label><input id="harvestedDate" name="harvestedDate" type="date" required max="@today.ToString("yyyy-MM-dd")" /><button class="btn-primary-green">@Ui.Text("Yes, crop harvested")</button></form></details>
}
<details style="margin-top:24px"><summary>@Ui.Text("Completed, skipped and replaced tasks")</summary>@foreach (var task in crop.Tasks.Where(t => t.Status != "Pending").OrderByDescending(t => t.DueDate)) { <partial name="_Task" model="task" /> }</details>
