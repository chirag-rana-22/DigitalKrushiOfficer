@model Digital_Krushi_Officer.Models.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"]="Change password"; }
<div class="page-header"><span class="eyebrow">@Ui.Text("ACCOUNT SECURITY")</span><h1>@Ui.Text("Change your password")</h1><p>@Ui.Text("Changing your password signs out your other sessions.")</p></div>
<form asp-action="ChangePassword" method="post" class="card p-4" style="max-width:600px"><div asp-validation-summary="ModelOnly" class="validation-msg"></div><div class="form-group"><label asp-for="CurrentPassword">@Ui.Text("Current password")</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="validation-msg"></span></div><div class="form-group"><label asp-for="NewPassword">@Ui.Text("New password")</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="validation-msg"></span><small>@Ui.Text("Use 10–64 characters.")</small></div><div class="form-group"><label asp-for="ConfirmPassword">@Ui.Text("Confirm password")</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="validation-msg"></span></div><button class="btn-primary-green">@Ui.Text("Update password")</button></form>
