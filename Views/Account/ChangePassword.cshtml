@model Digital_Krushi_Officer.Models.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"]="Change password"; }
<div class="page-header"><span class="eyebrow">ACCOUNT SECURITY</span><h1>Change your password</h1><p>Changing your password signs out your other sessions.</p></div>
<form asp-action="ChangePassword" method="post" class="card p-4" style="max-width:600px"><div asp-validation-summary="ModelOnly" class="validation-msg"></div><div class="form-group"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="validation-msg"></span></div><div class="form-group"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="validation-msg"></span><small>Use 10–64 characters.</small></div><div class="form-group"><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="validation-msg"></span></div><button class="btn-primary-green">Update password</button></form>
