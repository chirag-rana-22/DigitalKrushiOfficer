@model Digital_Krushi_Officer.Models.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; ViewData["HideLayout"] = true; Layout = "_Layout"; }
<div class="auth-page">
    <div class="auth-card" style="max-width:420px;">
        <div class="auth-logo">
            <div class="logo-icon" style="background:linear-gradient(135deg,#E53935,#EF5350);">🔓</div>
            <h2>@Ui.Text("Forgot Password?")</h2>
            <p>@Ui.Text("Enter your email to receive an OTP")</p>
        </div>
        @if(TempData["Error"] != null){ <div class="alert-banner danger mb-3">❌ @Ui.Text(TempData["Error"]?.ToString())</div> }
        <form asp-action="ForgotPassword" method="post" asp-antiforgery="true">

            <div class="form-group">
                <label class="form-label">@Ui.Text("📧 Email Address")</label>
                <input asp-for="Email" class="form-control" placeholder="your@email.com" />
                <span asp-validation-for="Email" class="validation-msg"></span>
            </div>
            <button type="submit" class="btn-primary-green w-100" style="justify-content:center;padding:14px;">@Ui.Text("📨 Send OTP")</button>
        </form>
        <p style="text-align:center;margin-top:16px;font-size:0.875rem;"><a href="/Account/Login" style="color:var(--green);">@Ui.Text("← Back to Login")</a></p>
    </div>
</div>
