@model Digital_Krushi_Officer.Models.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; ViewData["HideLayout"] = true; Layout = "_Layout"; }
<div class="auth-page">
    <div class="auth-card" style="max-width:440px;">
        <div class="auth-logo">
            <div class="logo-icon" style="background:linear-gradient(135deg,#E53935,#EF5350);">🔐</div>
            <h2>@Ui.Text("Reset Password")</h2>
            <p>@Ui.Text("Enter the OTP and your new password")</p>
        </div>
        @if (TempData["Warning"] != null) { <div class="alert-banner warning" role="status">@Ui.Text(TempData["Warning"]?.ToString())</div> }
        <form asp-action="ResetPassword" method="post" asp-antiforgery="true">

            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert-banner danger mb-3"></div>
            <div class="form-group">
                <label class="form-label">@Ui.Text("OTP Code")</label>
                <input asp-for="Token" class="form-control" style="text-align:center;font-size:1.5rem;letter-spacing:8px;font-weight:700;" placeholder="------" maxlength="6" />
                <span asp-validation-for="Token" class="validation-msg"></span>
            </div>
            <div class="form-group">
                <label class="form-label">@Ui.Text("🔒 New Password")</label>
                <input asp-for="NewPassword" class="form-control" placeholder="@Ui.Text("At least 10 characters")" />
                <span asp-validation-for="NewPassword" class="validation-msg"></span>
            </div>
            <div class="form-group">
                <label class="form-label">@Ui.Text("🔒 Confirm Password")</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="@Ui.Text("Repeat new password")" />
                <span asp-validation-for="ConfirmPassword" class="validation-msg"></span>
            </div>
            <button type="submit" class="btn-primary-green w-100" style="justify-content:center;padding:14px;">@Ui.Text("✅ Reset Password")</button>
        </form><a href="/Account/ForgotPassword">@Ui.Text("Request another code")</a>
    </div>
</div>
