@model Digital_Krushi_Officer.Models.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; ViewData["HideLayout"] = true; Layout = "_Layout"; }
<div class="auth-page">
    <div class="auth-card" style="max-width:440px;">
        <div class="auth-logo">
            <div class="logo-icon" style="background:linear-gradient(135deg,#E53935,#EF5350);">🔐</div>
            <h2>Reset Password</h2>
            <p>Enter the OTP and your new password</p>
        </div>
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert-banner danger mb-3"></div>
            <div class="form-group">
                <label class="form-label">OTP Code</label>
                <input asp-for="Token" class="form-control" style="text-align:center;font-size:1.5rem;letter-spacing:8px;font-weight:700;" placeholder="------" maxlength="6" />
                <span asp-validation-for="Token" class="validation-msg"></span>
            </div>
            <div class="form-group">
                <label class="form-label">🔒 New Password</label>
                <input asp-for="NewPassword" class="form-control" placeholder="Min 6 characters" />
                <span asp-validation-for="NewPassword" class="validation-msg"></span>
            </div>
            <div class="form-group">
                <label class="form-label">🔒 Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat new password" />
                <span asp-validation-for="ConfirmPassword" class="validation-msg"></span>
            </div>
            <button type="submit" class="btn-primary-green w-100" style="justify-content:center;padding:14px;">✅ Reset Password</button>
        </form>
    </div>
</div>
