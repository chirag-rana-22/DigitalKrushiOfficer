@model Digital_Krushi_Officer.Models.ViewModels.WeatherViewModel
@{ ViewData["Title"] = "Weather outlook"; ViewData["ActiveMenu"] = "Weather"; }
<div class="page-header"><span class="eyebrow">PLAN YOUR FIELD WORK</span><h1>Weather outlook</h1><p>A district forecast, with a clear time and source.</p></div>
<form asp-action="Search" method="post" class="card p-4 mb-4" asp-antiforgery="true"><div class="row g-3 align-items-end"><div class="col-md-8"><label for="district" class="form-label">District</label><input name="district" id="district" class="form-control" value="@Model?.District" placeholder="e.g. Ahmedabad" maxlength="100" required /></div><div class="col-md-4"><button class="btn-primary-green">Get forecast</button></div></div></form>
@if (Model == null) {
    <div class="empty-state card"><span class="eyebrow">NO VERIFIED WEATHER DATA</span><h2>Forecast unavailable</h2><p>Enter a district and try again. If the weather service is unavailable, no estimated weather is shown.</p></div>
} else {
    <div class="weather-card"><p>OPENWEATHER · DISTRICT FORECAST</p><h2>@Model.District</h2><div class="weather-temp">@Model.Temperature°C</div><p>@Model.Description</p><div class="row g-3"><div class="col-4">Humidity<br><strong>@Model.Humidity%</strong></div><div class="col-4">Rain probability<br><strong>@Model.RainChance%</strong></div><div class="col-4">Wind<br><strong>@Model.WindSpeed km/h</strong></div></div><hr><p>Forecast time: @Model.ForecastAt.AddHours(5.5).ToString("dd MMM yyyy, HH:mm") IST</p><p>Retrieved: @Model.FetchedAt.AddHours(5.5).ToString("HH:mm") IST · Next forecast interval, not a live observation.</p></div>
    <div class="card p-4 mt-4"><h3>Field planning note</h3><p>@Model.FarmingAlert</p><small>Conditions can vary between villages in the same district.</small></div>
}
