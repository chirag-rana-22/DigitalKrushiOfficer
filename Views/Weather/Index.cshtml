@model Digital_Krushi_Officer.Models.ViewModels.WeatherViewModel
@{ ViewData["Title"] = "Weather outlook"; ViewData["ActiveMenu"] = "Weather"; }
<div class="page-header"><span class="eyebrow">@Ui.Text("PLAN YOUR FIELD WORK")</span><h1>@Ui.Text("Weather outlook")</h1><p>@Ui.Text("A district forecast, with a clear time and source.")</p></div>
<form asp-action="Search" method="post" class="card p-4 mb-4" asp-antiforgery="true"><div class="row g-3 align-items-end"><div class="col-md-8"><label for="district" class="form-label">@Ui.Text("District")</label><input name="district" id="district" class="form-control" value="@Model?.District" placeholder="@Ui.Text("e.g. Ahmedabad")" maxlength="100" required /></div><div class="col-md-4"><button class="btn-primary-green">@Ui.Text("Get forecast")</button></div></div></form>
@if (Model == null) {
    <div class="empty-state card"><span class="eyebrow">@Ui.Text("NO VERIFIED WEATHER DATA")</span><h2>@Ui.Text("Forecast unavailable")</h2><p>@Ui.Text("Enter a district and try again. If the weather service is unavailable, no estimated weather is shown.")</p></div>
} else {
    <div class="weather-card"><p>@Ui.Text("OPENWEATHER · DISTRICT FORECAST")</p><h2>@Model.District</h2><div class="weather-temp">@Model.Temperature°C</div><p>@Ui.Text(Model.Description)</p><div class="row g-3"><div class="col-4">@Ui.Text("Humidity")<br><strong>@Model.Humidity%</strong></div><div class="col-4">@Ui.Text("Rain probability")<br><strong>@Model.RainChance%</strong></div><div class="col-4">@Ui.Text("Wind")<br><strong>@Model.WindSpeed km/h</strong></div></div><hr><p>@Ui.Text("Forecast time"): @Model.ForecastAt.AddHours(5.5).ToString("dd MMM yyyy, HH:mm") IST</p><p>@Ui.Text("Retrieved"): @Model.FetchedAt.AddHours(5.5).ToString("HH:mm") IST · @Ui.Text("Next forecast interval, not a live observation.")</p></div>
    <div class="card p-4 mt-4"><h3>@Ui.Text("Field planning note")</h3><p>@Ui.Text(Model.FarmingAlert)</p><small>@Ui.Text("Conditions can vary between villages in the same district.")</small></div>
}
