@model Digital_Krushi_Officer.Models.TblDiseaseDataset
@{ ViewData["Title"] = "Add Disease"; ViewData["ActiveMenu"] = "Diseases"; }
<div class="page-header"><h1>🔬 Add Disease Record</h1></div>
<div class="card p-4" style="max-width:660px;">
    <form asp-action="AddDisease" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="grid-2">
            <div class="form-group"><label class="form-label">🌾 Crop Name</label><input asp-for="CropName" class="form-control" required /></div>
            <div class="form-group"><label class="form-label">🦠 Disease Name</label><input asp-for="DiseaseName" class="form-control" required /></div>
        </div>
        <div class="form-group"><label class="form-label">🔍 Symptoms</label><textarea asp-for="Symptoms" class="form-control" rows="3"></textarea></div>
        <div class="form-group"><label class="form-label">💊 Solution / Treatment</label><textarea asp-for="Solution" class="form-control" rows="3"></textarea></div>
        <div class="grid-2">
            <div class="form-group"><label class="form-label">🧪 Recommended Pesticide</label><input asp-for="RecommendedPesticide" class="form-control" /></div>
            <div class="form-group">
                <label class="form-label">⚠ Severity Level</label>
                <select asp-for="SeverityLevel" class="form-control form-select">
                    <option>Low</option><option>Medium</option><option>High</option><option>Critical</option>
                </select>
            </div>
        </div>

        
        <div class="form-group" style="margin-top:12px;">
            <label class="form-label">🖼️ Disease Reference Image</label>
            <input type="file" id="diseaseImageInput" name="DiseaseImage" class="form-control"
                   accept="image/*" onchange="previewDiseaseImage(event)"
                   style="padding:8px;" />
            <small style="color:var(--text-muted,#888);display:block;margin-top:4px;">
                Accepted formats: JPG, PNG, WEBP &nbsp;|&nbsp; Max size: 5 MB
            </small>
        </div>


        <div id="diseaseImagePreviewContainer" style="display:none;margin-bottom:14px;">
            <label class="form-label">Preview</label>
            <div style="border:2px dashed var(--border-color,#ccc);border-radius:10px;padding:10px;text-align:center;background:var(--card-bg,#f9f9f9);">
                <img id="diseaseImagePreview" src="#" alt="Disease Image Preview"
                     style="max-width:100%;max-height:220px;border-radius:8px;object-fit:contain;" />
            </div>
        </div>

        <div style="display:flex;gap:10px;margin-top:8px;">
            <button type="submit" class="btn-primary-green" style="flex:1;justify-content:center;padding:13px;">✅ Add Disease</button>
            <a href="/Admin/Diseases" class="btn-outline-green" style="padding:13px 20px;text-decoration:none;">Cancel</a>
        </div>
    </form>
</div>

<script>
    function previewDiseaseImage(event) {
        const file = event.target.files[0];
        if (!file) return;

        if (file.size > 5 * 1024 * 1024) {
            alert('Image size must be 5 MB or less.');
            event.target.value = '';
            document.getElementById('diseaseImagePreviewContainer').style.display = 'none';
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById('diseaseImagePreview').src = e.target.result;
            document.getElementById('diseaseImagePreviewContainer').style.display = 'block';
        };
        reader.readAsDataURL(file);
    }
</script>
