@{
    ViewData["Title"] = "Analytics";
    ViewData["ActiveMenu"] = "Analytics";
    var queryByType = ViewBag.QueryByType as dynamic ?? new List<dynamic>();
    var queryByStatus = ViewBag.QueryByStatus as dynamic ?? new List<dynamic>();
}
<div class="page-header"><h1>@Ui.Text("📈 AI Analytics")</h1><p>@Ui.Text("System performance and query insights")</p></div>
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card p-4">
            <h5 style="font-weight:700;margin-bottom:16px;">@Ui.Text("📊 Queries by Type")</h5>
            @foreach (var item in queryByType)
            {
                var pct = item.Count > 0 ? 100 : 0;
                <div style="margin-bottom:14px;">
                    <div style="display:flex;justify-content:space-between;margin-bottom:5px;font-size:0.85rem;">
                        <span style="font-weight:600;">@(item.Type ?? "Unknown")</span>
                        <span style="font-weight:700;color:var(--green);">@item.Count</span>
                    </div>
                    <div style="height:8px;background:#E0E0E0;border-radius:4px;overflow:hidden;">
                        <div style="height:100%;background:var(--green);border-radius:4px;width:@pct%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-4">
            <h5 style="font-weight:700;margin-bottom:16px;">@Ui.Text("📊 Queries by Status")</h5>
            @foreach (var item in queryByStatus)
            {
                var color = item.Status == "Answered" ? "var(--green)" : item.Status == "Escalated" ? "var(--yellow)" : "var(--text-gray)";
                <div style="margin-bottom:14px;">
                    <div style="display:flex;justify-content:space-between;margin-bottom:5px;font-size:0.85rem;">
                        <span style="font-weight:600;">@(item.Status ?? "Unknown")</span>
                        <span style="font-weight:700;color:@color;">@item.Count</span>
                    </div>
                    <div style="height:8px;background:#E0E0E0;border-radius:4px;overflow:hidden;">
                        <div style="height:100%;background:@color;border-radius:4px;width:70%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
