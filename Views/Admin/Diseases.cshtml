@model List<Digital_Krushi_Officer.Models.TblDiseaseDataset>
@{
    ViewData["Title"] = "Disease Dataset";
    ViewData["ActiveMenu"] = "Diseases";
}
<div class="page-header d-flex justify-between align-center">
    <div><h1>@Ui.Text("🔬 Disease Dataset")</h1><p>@Ui.Text("Crop disease knowledge base")</p></div>
    <a href="/Admin/AddDisease" class="btn-primary-green">@Ui.Text("➕ Add Disease")</a>
</div>
<div class="card">
    <div style="overflow-x:auto;">
        <table class="data-table">
            <thead><tr><th>@Ui.Text("Crop")</th><th>@Ui.Text("Disease")</th><th>@Ui.Text("Pesticide")</th><th>@Ui.Text("Severity")</th><th>@Ui.Text("Status")</th><th>@Ui.Text("Action")</th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td style="font-weight:600;">@Ui.Text(d.CropName)</td>
                        <td style="font-weight:600;">@Ui.Text(d.DiseaseName)</td>
                        <td style="font-size:0.82rem;color:var(--text-gray);">@d.RecommendedPesticide</td>
                        <td><span class="badge @(d.SeverityLevel=="Critical"?"badge-red":d.SeverityLevel=="High"?"badge-red":d.SeverityLevel=="Medium"?"badge-yellow":"badge-green")">@Ui.Text(d.SeverityLevel)</span></td>
                        <td><span class="badge @(d.IsActive?"badge-green":"badge-red")">@(d.IsActive?"Active":"Inactive")</span></td>
                        <td style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                            <a href="/Admin/EditDisease/@d.Id" class="btn-outline-green" style="padding:6px 14px;font-size:0.78rem;text-decoration:none;">@Ui.Text("✏️ Update")</a>
                            <form asp-action="ToggleDiseaseStatus" method="post" style="display:inline;" asp-antiforgery="true">

                                <input type="hidden" name="id" value="@d.Id" />
                                <button type="submit" class="@(d.IsActive?"btn-red":"btn-primary-green")" style="padding:6px 14px;font-size:0.78rem;">@(d.IsActive?"Deactivate":"Activate")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
