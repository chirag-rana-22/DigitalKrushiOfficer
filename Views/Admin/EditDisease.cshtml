@model Digital_Krushi_Officer.Models.TblDiseaseDataset
@{ ViewData["Title"] = "Update Disease Record"; ViewData["ActiveMenu"] = "Diseases"; }
<div class="page-header"><h1>@Ui.Text("✏️ Update Disease Record")</h1></div>
<div class="card p-4" style="max-width:640px;">
    <form asp-action="EditDisease" method="post" asp-antiforgery="true">

        <input asp-for="Id" type="hidden" />
        <div class="grid-2">
            <div class="form-group"><label class="form-label">@Ui.Text("🌾 Crop Name")</label><input asp-for="CropName" class="form-control" required /></div>
            <div class="form-group"><label class="form-label">@Ui.Text("🦠 Disease Name")</label><input asp-for="DiseaseName" class="form-control" required /></div>
        </div>
        <div class="form-group"><label class="form-label">@Ui.Text("🔍 Symptoms")</label><textarea asp-for="Symptoms" class="form-control" rows="3"></textarea></div>
        <div class="form-group"><label class="form-label">@Ui.Text("💊 Solution / Treatment")</label><textarea asp-for="Solution" class="form-control" rows="3"></textarea></div>
        <div class="grid-2">
            <div class="form-group"><label class="form-label">@Ui.Text("🧪 Recommended Pesticide")</label><input asp-for="RecommendedPesticide" class="form-control" /></div>
            <div class="form-group">
                <label class="form-label">@Ui.Text("⚠ Severity Level")</label>
                <select asp-for="SeverityLevel" class="form-control form-select">
                    <option>@Ui.Text("Low")</option><option>@Ui.Text("Medium")</option><option>@Ui.Text("High")</option><option>@Ui.Text("Critical")</option>
                </select>
            </div>
        </div>
        <div class="form-group"><label class="form-label">@Ui.Text("🖼 Reference Image Path")</label><input asp-for="ReferenceImagePath" class="form-control" placeholder="/images/diseases/example.jpg" /></div>
        <div class="form-group">
            <label class="form-label">@Ui.Text("🔄 Status")</label>
            <select asp-for="IsActive" class="form-control form-select">
                <option value="true">@Ui.Text("Active")</option>
                <option value="false">@Ui.Text("Inactive")</option>
            </select>
        </div>
        <div style="display:flex;gap:10px;margin-top:8px;">
            <button type="submit" class="btn-primary-green" style="flex:1;justify-content:center;padding:13px;">@Ui.Text("💾 Save Changes")</button>
            <a href="/Admin/Diseases" class="btn-outline-green" style="padding:13px 20px;text-decoration:none;">@Ui.Text("Cancel")</a>
        </div>
    </form>
</div>
