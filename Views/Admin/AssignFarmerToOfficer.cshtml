@model List<dynamic>
@{
    ViewData["Title"] = "Assign Farmers to Officers";
    ViewData["ActiveMenu"] = "AssignFarmers";
    var districts = ViewBag.Districts as List<string>;
    var selectedDistrict = ViewBag.SelectedDistrict as string;
    var search = ViewBag.Search as string;
}

<div class="page-header d-flex justify-between align-center">
    <div>
        <h1>👨‍🌾 Assign Farmers to Officers</h1>
        <p>Manage location-based farmer-officer assignments</p>
    </div>
</div>

<div class="card mb-3 p-3">
    <form method="get">
        <div style="display:flex;gap:12px;align-items:center;">
            <select name="district" class="form-control" style="flex:1;max-width:300px;" onchange="this.form.submit()">
                <option value="">-- Select District --</option>
                @foreach (var district in districts ?? new List<string>())
                {
                    <option value="@district" selected="@(selectedDistrict == district)">@district</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(selectedDistrict))
            {
                <input type="hidden" name="district" value="@selectedDistrict" />
                <input type="text" name="search" class="form-control" placeholder="Search farmer by name..." value="@search"
                       style="flex:1;" />
                <button type="submit" class="btn-primary-green" style="padding:10px 24px;">🔍 Search</button>
                @if (search != null)
                {
                    <a href="/Admin/AssignFarmerToOfficer?district=@selectedDistrict" class="btn-outline-green"
                       style="padding:10px 18px;text-decoration:none;">✕ Clear</a>
                }
            }
        </div>
    </form>
</div>

@if (!string.IsNullOrEmpty(selectedDistrict))
{
    if (!Model.Any())
    {
        <div class="card" style="padding:32px;text-align:center;color:var(--text-gray);">
            <p>No farmers found in @selectedDistrict district.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div style="overflow-x:auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Farmer Name</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Village</th>
                            <th>Current Officer</th>
                            <th>Assign Officer</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var farmer = item.Farmer as Digital_Krushi_Officer.Models.TblUser;
                            if (farmer == null) { continue; }
                            var assignedOfficer = item.AssignedOfficer as Digital_Krushi_Officer.Models.TblUser;
                            var availableOfficers = item.AvailableOfficers as List<Digital_Krushi_Officer.Models.TblUser>;

                            <tr>
                                <td style="color:var(--text-gray);font-weight:600;">@farmer.Id</td>
                                <td style="font-weight:600;">@farmer.Name</td>
                                <td style="font-size:0.82rem;color:var(--text-gray);">@farmer.Email</td>
                                <td>@farmer.Mobile</td>
                                <td>@farmer.Village</td>
                                <td>
                                    @if (assignedOfficer != null)
                                    {
                                        <span class="badge badge-green">✓ @assignedOfficer.Name</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-yellow">⚠ Not Assigned</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;gap:8px;align-items:center;">
                                        <form method="post" asp-action="AssignFarmerToOfficer" style="display:inline;flex:1;" asp-antiforgery="true">

                                            <input type="hidden" name="farmerId" value="@farmer.Id" />
                                            <div style="display:flex;gap:4px;">
                                                <select name="officerId" class="form-control"
                                                        style="font-size:0.85rem;padding:6px 8px;flex:1;">
                                                    <option value="">-- Select Officer --</option>
                                                    @foreach (var officer in availableOfficers ?? new
                                        List<Digital_Krushi_Officer.Models.TblUser>())
                                                    {
                                                        <option value="@officer.Id" selected="@(assignedOfficer?.Id == officer.Id)">
                                                            @officer.Name
                                                        </option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn-primary-green"
                                                        style="padding:6px 14px;font-size:0.78rem;white-space:nowrap;">
                                                    Assign
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </td>
                                <td>
                                    <div style="display:flex;gap:8px;">
                                        @if (assignedOfficer != null)
                                        {
                                            <form method="post" asp-action="UnassignFarmer" style="display:inline;" asp-antiforgery="true">

                                                <input type="hidden" name="farmerId" value="@farmer.Id" />
                                                <button type="submit" class="btn-red" style="padding:6px 14px;font-size:0.78rem;"
                                                        onclick="return confirm('Remove assignment?')">
                                                    Remove
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <div class="card" style="padding:32px;text-align:center;color:var(--text-gray);">
        <p>👉 Select a district to see farmers and assign them to officers.</p>
    </div>
}

<style>
    .d-flex {
        display: flex;
    }

    .justify-between {
        justify-content: space-between;
    }

    .align-center {
        align-items: center;
    }

    .badge-green {
        background-color: #d4edda;
        color: #155724;
    }

    .badge-yellow {
        background-color: #fff3cd;
        color: #856404;
    }

    .badge-red {
        background-color: #f8d7da;
        color: #721c24;
    }
</style>
