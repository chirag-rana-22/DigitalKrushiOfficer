<!-- CTA -->
<section style="padding:80px 0;text-align:center;background:#F8F9FA;">
    <div class="container">
        <h2 style="font-size:2rem;font-weight:800;color:#212121;margin-bottom:16px;">Ready to Transform Your Farming?</h2>
        <p style="color:#757575;max-width:450px;margin:0 auto 32px;">Join thousands of farmers who get smarter every day with Digital Krushi Officer.</p>
