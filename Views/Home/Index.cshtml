@{ ViewData["Title"]="Grow with better guidance"; ViewData["HideLayout"]=true; }
<nav class="public-nav"><a class="wordmark" href="/">DK<span>O</span><small>Digital Krushi Officer</small></a><div><a href="#how-it-works">@Ui.Text("How it works")</a><a href="/Account/Login">@Ui.Text("Sign in")</a><a class="btn-primary-green" href="/Account/Register">@Ui.Text("Get started ↗")</a></div></nav>
<main id="main" class="landing">
<section class="new-hero"><div class="hero-copy"><span class="eyebrow">@Ui.Text("ROOTED IN YOUR FIELD. READY FOR TOMORROW.")</span><h1>@Ui.Text("Better guidance.")<br><em>@Ui.Text("Stronger roots.")</em></h1><p>@Ui.Text("Your crops, questions and local expertise, together in one place. Get help in Gujarati, Hindi, Marathi or English, with direct AI answers and officer support for difficult cases.")</p><div class="hero-actions"><a class="btn-primary-green" href="/Account/Register">@Ui.Text("Start your farming journey")<span>↗</span></a><a class="text-link" href="#how-it-works">@Ui.Text("Explore how it works ↓")</a></div><div class="language-strip"><span>ગુજરાતી</span><span>हिन्दी</span><span>मराठी</span><span>English</span></div></div>
<div class="hero-visual" aria-label="@Ui.Text("Illustration of farm fields and the advisory journey")"><div class="field-sun"></div><div class="field-ridge ridge-one"></div><div class="field-ridge ridge-two"></div><div class="field-ridge ridge-three"></div><div class="visual-label">@Ui.Text("A LITTLE CLARITY.")<br>@Ui.Text("A LOT OF POSSIBILITY.")</div><div class="journey-preview"><span class="eyebrow">@Ui.Text("YOUR ADVISORY JOURNEY")</span><h3>@Ui.Text("From a question")<br>@Ui.Text("to a clearer next step.")</h3><div><b>01</b>@Ui.Text("Share a question or crop photo")</div><div><b>02</b>@Ui.Text("AI answers; difficult cases go to an officer")</div><div><b>03</b>@Ui.Text("Read, follow up and give feedback")</div><small>@Ui.Text("Illustration of the workflow")</small></div></div></section>
<section id="how-it-works" class="feature-section"><div class="section-heading"><span class="eyebrow">@Ui.Text("MADE FOR EVERYDAY FARMING")</span><h2>@Ui.Text("Your field companion,")<br>@Ui.Text("through every season.")</h2><p>@Ui.Text("Practical tools that keep your farm information and conversations connected.")</p></div><div class="feature-grid"><article><span class="feature-number">@Ui.Text("01 / ASK")</span><h3>@Ui.Text("A question is a good place to start.")</h3><p>@Ui.Text("Type your question or use voice input where your browser supports it. Get advice in your preferred language.")</p></article><article><span class="feature-number">@Ui.Text("02 / OBSERVE")</span><h3>@Ui.Text("Show what you see.")</h3><p>@Ui.Text("Share a clear crop photo for AI assessment. Unclear or uncertain cases go to an officer. Photos stay private to your advisory team.")</p></article><article><span class="feature-number">@Ui.Text("03 / PLAN")</span><h3>@Ui.Text("Keep your season in view.")</h3><p>@Ui.Text("Track crops, check district forecasts and explore scheme information from your dashboard.")</p></article></div></section>
<section class="human-section"><span class="eyebrow">@Ui.Text("AI FIRST. EXPERT HELP WHEN NEEDED.")</span><h2>@Ui.Text("Useful assistance.")<br>@Ui.Text("Accountable advice.")</h2><p>@Ui.Text("AI answers everyday farming questions directly. When it cannot reliably solve a question or assess a crop photo, the case goes automatically to an available Krushi Officer. Every question has a visible status.")</p><a class="btn-primary-green" href="/Account/Register">@Ui.Text("Create your account ↗")</a></section>
</main><footer class="public-footer"><span>@Ui.Text("Digital Krushi Officer · Independent agriculture advisory")</span><a href="/Home/Privacy">@Ui.Text("Privacy & data use")</a><span>© @DateTime.Now.Year</span></footer>
