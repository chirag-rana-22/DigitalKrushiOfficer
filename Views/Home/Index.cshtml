@{
    ViewData["Title"] = "Digital Krushi Officer - AI Agriculture Assistant";
    ViewData["HideLayout"] = true;
    Layout = "_Layout";
}

<div class="landing-hero">
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6 hero-content py-5">
                <div class="hero-badge">
                    <span>🤖</span> AI-Powered Agriculture
                </div>
                <h1 class="hero-title">
                    Your <span>Digital Krushi</span><br>Officer is Here
                </h1>
                <p class="hero-desc">
                    Get instant expert farming advice 24/7 in Gujarati. Ask about crop diseases, 
                    weather, government schemes, pesticides & more — powered by AI.
                </p>
                <div class="hero-btns">
                    <a href="/Account/Register" class="btn-hero-primary">🌾 Get Started Free</a>
                    <a href="/Account/Login" class="btn-hero-outline">🔑 Login</a>
                </div>
                <div class="d-flex gap-3 mt-4 flex-wrap">
                    <div style="color:rgba(255,255,255,0.8);font-size:0.82rem;">✅ Free for Farmers</div>
                    <div style="color:rgba(255,255,255,0.8);font-size:0.82rem;">✅ Gujarati Language</div>
                    <div style="color:rgba(255,255,255,0.8);font-size:0.82rem;">✅ 24/7 AI Support</div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-flex justify-content-center align-items-center py-5">
                <div style="background:rgba(255,255,255,0.1);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.2);border-radius:24px;padding:32px;width:380px;">
                    <div style="background:rgba(255,255,255,0.15);border-radius:16px;padding:16px;margin-bottom:16px;">
                        <div style="color:rgba(255,255,255,0.6);font-size:0.72rem;margin-bottom:8px;">🌾 FARMER QUERY</div>
                        <div style="color:white;font-size:0.9rem;">મારા કપાસના પાંદડા પીળા થઈ રહ્યા છે, શું કરવું?</div>
                    </div>
                    <div style="background:white;border-radius:16px;padding:16px;margin-bottom:12px;">
                        <div style="color:#2E7D32;font-size:0.72rem;font-weight:700;margin-bottom:8px;">🤖 AI KRUSHI OFFICER</div>
                        <div style="color:#212121;font-size:0.85rem;line-height:1.5;">કપાસ પીળા પડવાના કારણ: Nitrogen ઉણપ અથવા Spider Mite. Urea 25kg/acre + Dimethoate 1.5ml/L પાણી સાથે છાંટો...</div>
                        <div style="margin-top:10px;display:flex;gap:6px;">
                            <span style="background:#E8F5E9;color:#2E7D32;padding:3px 8px;border-radius:12px;font-size:0.7rem;font-weight:600;">Confidence: 92%</span>
                            <span style="background:#E3F2FD;color:#1565C0;padding:3px 8px;border-radius:12px;font-size:0.7rem;">AI Gemini-Pro</span>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;background:rgba(255,255,255,0.1);border-radius:12px;padding:10px;">
                        <div style="flex:1;background:rgba(255,255,255,0.9);border-radius:8px;padding:8px;font-size:0.8rem;color:#757575;">Ask your farming question...</div>
                        <div style="width:36px;height:36px;background:#2E7D32;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:1rem;">➤</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<section style="padding:80px 0;background:#F8F9FA;">
    <div class="container">
        <div class="text-center mb-5">
