@model List<Digital_Krushi_Officer.Models.TblQuery>
@{
    ViewData["Title"] = "Officer Replies";
    ViewData["ActiveMenu"] = "OfficerReplies";
    var total  = Model.Count;
    var solved = Model.Count(q => q.Escalation?.Status == "Solved");
    var avgRating = Model.Any(q => q.Feedbacks.Any())
        ? Model.Where(q => q.Feedbacks.Any())
               .Average(q => (double)q.Feedbacks.First().Rating)
               .ToString("0.0")
        : "–";
}

@section Styles {
<style>
/* ── Page header ── */
.or-page-header { display:flex; align-items:center; gap:14px; margin-bottom:20px; }
.or-page-icon  { width:52px; height:52px; background:linear-gradient(135deg,#F57F17,#FBC02D);
                 border-radius:14px; display:flex; align-items:center; justify-content:center;
                 font-size:1.5rem; box-shadow:0 4px 12px rgba(245,127,23,.3); flex-shrink:0; }
.or-page-title h1 { margin:0; font-size:1.3rem; font-weight:700; }
.or-page-title p  { margin:0; font-size:0.82rem; color:var(--text-gray,#666); }

/* ── Stats bar ── */
.or-stats { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:24px; }
.or-stat  { background:#fff; border:1px solid #e0e0e0; border-radius:10px;
            padding:10px 18px; display:flex; align-items:center; gap:10px; }
.or-stat-icon { font-size:1.2rem; }
.or-stat-val  { font-weight:700; font-size:1.05rem; color:#333; }
.or-stat-lbl  { color:#888; font-size:0.75rem; }

/* ── Thread card ── */
.thread-card { background:#fff; border-radius:18px; border:1px solid #e8e8e8;
               margin-bottom:24px; overflow:hidden;
               box-shadow:0 2px 10px rgba(0,0,0,.06); }

/* card top bar */
.thread-meta { background:linear-gradient(135deg,#FFFDE7,#FFF3E0);
               padding:10px 18px; border-bottom:1px solid #FFE082;
               display:flex; align-items:center; justify-content:space-between;
               flex-wrap:wrap; gap:8px; }
.thread-type { font-size:0.72rem; font-weight:700; letter-spacing:.4px;
               padding:3px 10px; border-radius:20px; }
.type-text  { background:#E8F5E9; color:#2E7D32; }
.type-image { background:#E3F2FD; color:#1565C0; }
.type-voice { background:#F3E5F5; color:#6A1B9A; }
.thread-date { font-size:0.72rem; color:#999; }
.thread-status { font-size:0.72rem; font-weight:700; padding:3px 10px;
                 border-radius:20px; }
.status-solved { background:#E8F5E9; color:#2E7D32; }
.status-inprog { background:#E3F2FD; color:#1565C0; }

/* ── Conversation body ── */
.thread-body { padding:18px 20px; display:flex; flex-direction:column; gap:14px; }

/* Farmer question bubble (right) */
.q-row  { display:flex; justify-content:flex-end; gap:10px; }
.q-bubble { background:linear-gradient(135deg,#2E7D32,#43A047); color:#fff;
             border-radius:16px 16px 4px 16px; padding:12px 16px;
             max-width:75%; font-size:0.88rem; line-height:1.6; }
.q-bubble img { max-width:100%; border-radius:10px; display:block; margin-bottom:8px; }
.q-label { font-size:0.68rem; font-weight:700; letter-spacing:.5px;
           opacity:.8; margin-bottom:5px; }
.q-ts    { font-size:0.67rem; opacity:.6; text-align:right; margin-top:5px; }

/* Officer reply bubble (left) */
.r-row    { display:flex; gap:10px; }
.r-avatar { width:36px; height:36px; background:linear-gradient(135deg,#F57F17,#FBC02D);
            border-radius:50%; display:flex; align-items:center; justify-content:center;
            font-size:1rem; flex-shrink:0; box-shadow:0 2px 6px rgba(245,127,23,.3); }
.r-bubble { background:#FFFDE7; border:1px solid #FFE082; border-radius:16px 16px 16px 4px;
            padding:12px 16px; max-width:78%; font-size:0.88rem; line-height:1.7; color:#333; }
.r-label  { font-size:0.68rem; font-weight:700; letter-spacing:.5px;
            color:#F57F17; margin-bottom:5px; }
.r-officer-name { font-size:0.72rem; color:#999; font-weight:400; margin-left:6px; }
.r-ts     { font-size:0.67rem; color:#bbb; text-align:right; margin-top:6px; }

/* Feedback row */
.fb-row   { display:flex; gap:4px; align-items:center; margin-top:6px; padding-left:46px; }
.fb-label { font-size:0.72rem; color:#999; margin-right:4px; }
.fb-row button { background:none; border:none; font-size:1rem; cursor:pointer;
                 padding:2px; transition:transform .15s; }
.fb-row button:hover { transform:scale(1.25); }

/* Empty state */
.empty-state { text-align:center; padding:60px 20px; }
.empty-icon  { font-size:3.5rem; margin-bottom:14px; }
.empty-title { font-size:1.2rem; font-weight:700; color:#333; margin-bottom:8px; }
.empty-text  { font-size:0.88rem; color:#888; margin-bottom:20px; }
</style>
}

<div class="or-page-header">
    <div class="or-page-icon">👮</div>
    <div class="or-page-title">
        <h1>Officer Replies</h1>
        <p>Your questions answered by Krushi Officers — shown as conversations</p>
    </div>
</div>

<div class="or-stats">
    <div class="or-stat">
        <div class="or-stat-icon">📨</div>
        <div><div class="or-stat-val">@total</div><div class="or-stat-lbl">Total Replies</div></div>
    </div>
    <div class="or-stat">
        <div class="or-stat-icon">✅</div>
        <div><div class="or-stat-val">@solved</div><div class="or-stat-lbl">Solved</div></div>
    </div>
    <div class="or-stat">
        <div class="or-stat-icon">🌟</div>
        <div><div class="or-stat-val">@avgRating</div><div class="or-stat-lbl">Avg Rating</div></div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">👮</div>
        <div class="empty-title">No Officer Replies Yet</div>
        <div class="empty-text">When a Krushi Officer responds to your query, the full conversation will appear here.</div>
        <a href="/Chat/Index" class="btn-primary-green" style="text-decoration:none;display:inline-block;padding:10px 24px;">🤖 Ask AI Now</a>
    </div>
}
else
{
    @foreach (var q in Model)
    {
        var esc      = q.Escalation;
        var typeIcon = q.QueryType == "Image" ? "📷" : q.QueryType == "Voice" ? "🎤" : "💬";
        var typeCls  = q.QueryType == "Image" ? "type-image" : q.QueryType == "Voice" ? "type-voice" : "type-text";
        var fb       = q.Feedbacks.FirstOrDefault();

        <div class="thread-card">
            <!-- Card top meta bar -->
            <div class="thread-meta">
                <div style="display:flex;gap:8px;align-items:center;">
                    <span class="thread-type @typeCls">@typeIcon @q.QueryType</span>
                    @if (esc?.Status == "Solved")
                    {
                        <span class="thread-status status-solved">✅ Solved</span>
                    }
                    else
                    {
                        <span class="thread-status status-inprog">🔄 In Progress</span>
                    }
                </div>
                <span class="thread-date">📅 @q.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
            </div>

            <div class="thread-body">

                <!-- ── Farmer's Question (right bubble) ── -->
                <div class="q-row">
                    <div class="q-bubble">
                        <div class="q-label">👨‍🌾 YOUR QUESTION</div>
                        @if (q.QueryType == "Image" && q.ImagePath != null)
                        {
                            <img src="@q.ImagePath" alt="Crop image" />
                        }
                        <div>@q.QueryText</div>
                        <div class="q-ts">@q.CreatedDate.ToString("hh:mm tt")</div>
                    </div>
                </div>

                <!-- ── Officer's Reply (left bubble) ── -->
                <div class="r-row">
                    <div class="r-avatar">👮</div>
                    <div>
                        <div class="r-bubble">
                            <div class="r-label">
                                👮 KRUSHI OFFICER
                                @if (esc?.Officer != null)
                                {
                                    <span class="r-officer-name">— @esc.Officer.Name</span>
                                }
                            </div>
                            <div style="white-space:pre-wrap;">@esc?.OfficerReply</div>
                            @if (esc?.ResolvedDate != null)
                            {
                                <div class="r-ts">Replied on @esc.ResolvedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                            }
                        </div>

                        <!-- Star feedback -->
                        <div class="fb-row" id="fb-@q.Id">
                            <span class="fb-label">Rate this reply:</span>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <button onclick="submitFeedback(@q.Id, @i)" title="Rate @i star">
                                    @(fb?.Rating >= i ? "⭐" : "☆")
                                </button>
                            }
                            @if (fb != null)
                            {
                                <span style="font-size:0.72rem;color:#888;margin-left:4px;">(@fb.Rating/5)</span>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
}

@section Scripts {
<script>
    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }
    async function submitFeedback(queryId, rating) {
        var fd = new FormData();
        fd.append('queryId', queryId);
        fd.append('rating', rating);
        fd.append('feedbackType', rating >= 4 ? 'Helpful' : 'NotHelpful');
        await fetch('/Farmer/SubmitFeedback', { method: 'POST', headers: { 'RequestVerificationToken': getToken() }, body: fd });
        var el = document.getElementById('fb-' + queryId);
        if (el) el.querySelectorAll('button').forEach((b, i) => b.textContent = i < rating ? '⭐' : '☆');
    }
</script>
@Html.AntiForgeryToken()
}
