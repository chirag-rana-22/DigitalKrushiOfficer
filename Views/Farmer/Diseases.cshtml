@model List<Digital_Krushi_Officer.Models.TblDiseaseDataset>
@{
    ViewData["Title"] = "Disease Library";
    ViewData["ActiveMenu"] = "Diseases";
    var cropNames = ViewBag.CropNames as List<string> ?? new List<string>();
    var selectedCrop = ViewBag.SelectedCrop as string ?? "";
    var search = ViewBag.Search as string ?? "";
}

<div class="page-header d-flex justify-between align-center">
    <div>
        <h1>🔬 Disease Library</h1>
        <p>Identify crop diseases and find treatments</p>
    </div>
</div>

@* Search & Filter Bar *@
<form method="get" asp-action="Diseases" style="margin-bottom:24px;">
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="🔍 Search disease, crop or symptom..."
               style="flex:1;min-width:200px;max-width:360px;" />

        <select name="crop" class="form-control form-select" style="min-width:180px;max-width:240px;"
                onchange="this.form.submit()">
            <option value="">🌾 All Crops</option>
            @foreach (var c in cropNames)
            {
                <option value="@c" selected="@(c == selectedCrop ? "selected" : null)">@c</option>
            }
        </select>

        <button type="submit" class="btn-primary-green" style="padding:10px 22px;">Search</button>

        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(selectedCrop))
        {
            <a href="/Farmer/Diseases" class="btn-outline-green" style="padding:10px 18px;text-decoration:none;">✕ Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="card p-5 text-center">
        <div style="font-size:4rem;margin-bottom:16px;">🔬</div>
        <h4 style="font-weight:700;">No diseases found</h4>
        <p style="color:var(--text-gray);">
            @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(selectedCrop))
            {
                <span>Try adjusting your search or filter.</span>
            }
            else
            {
                <span>No disease records available yet.</span>
            }
        </p>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;">
        @foreach (var d in Model)
        {
            var severityColor = d.SeverityLevel switch
            {
                "Critical" => "#dc2626",
                "High"     => "#ea580c",
                "Medium"   => "#d97706",
                _          => "#16a34a"
            };
            var severityBg = d.SeverityLevel switch
            {
                "Critical" => "#fef2f2",
                "High"     => "#fff7ed",
                "Medium"   => "#fffbeb",
                _          => "#f0fdf4"
            };

            @* Disease Card *@
            <div class="card disease-card" style="border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:transform 0.2s,box-shadow 0.2s;cursor:pointer;"
                 onclick="openDiseaseModal(@d.Id)">

                @* Image Section *@
                <div style="width:100%;height:180px;overflow:hidden;background:linear-gradient(135deg,#e8f5e9,#c8e6c9);display:flex;align-items:center;justify-content:center;position:relative;">
                    @if (!string.IsNullOrEmpty(d.ReferenceImagePath))
                    {
                        <img src="@d.ReferenceImagePath" alt="@d.DiseaseName"
                             style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        <div style="font-size:4rem;opacity:0.5;">🦠</div>
                    }
                    @* Severity Badge overlay *@
                    <span style="position:absolute;top:10px;right:10px;background:@severityColor;color:#fff;padding:3px 10px;border-radius:20px;font-size:0.72rem;font-weight:700;letter-spacing:0.5px;">
                        @d.SeverityLevel
                    </span>
                </div>

                @* Card Content *@
                <div style="padding:18px;flex:1;display:flex;flex-direction:column;gap:8px;">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                        <div>
                            <h5 style="font-weight:700;font-size:1.02rem;margin:0 0 2px;">@d.DiseaseName</h5>
                            <span style="font-size:0.78rem;color:var(--text-gray);">🌾 @d.CropName</span>
                        </div>
                        <div style="background:@severityBg;color:@severityColor;padding:4px 10px;border-radius:8px;font-size:0.72rem;font-weight:700;white-space:nowrap;">
                            @d.SeverityLevel
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(d.Symptoms))
                    {
                        <p style="font-size:0.82rem;color:var(--text-gray);margin:0;line-height:1.5;
                                  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                            🔍 @d.Symptoms
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(d.RecommendedPesticide))
                    {
                        <div style="background:#f0fdf4;border-radius:8px;padding:7px 12px;font-size:0.8rem;color:#166534;display:flex;gap:6px;align-items:center;">
                            <span>🧪</span>
                            <span style="font-weight:600;">@d.RecommendedPesticide</span>
                        </div>
                    }

                    <div style="margin-top:auto;padding-top:10px;border-top:1px solid var(--border-color,#eee);font-size:0.75rem;color:var(--text-gray);">
                        Tap to view full details →
                    </div>
                </div>
            </div>

            @* Detail Modal for this disease *@
            <div id="diseaseModal-@d.Id" class="disease-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:9999;align-items:center;justify-content:center;padding:16px;">
                <div class="card" style="max-width:620px;width:100%;max-height:90vh;overflow-y:auto;border-radius:18px;position:relative;">
                    <button onclick="closeDiseaseModal(@d.Id)"
                            style="position:absolute;top:14px;right:16px;background:none;border:none;font-size:1.6rem;cursor:pointer;z-index:1;line-height:1;">✕</button>

                    @* Modal image *@
                    @if (!string.IsNullOrEmpty(d.ReferenceImagePath))
                    {
                        <div style="width:100%;height:240px;overflow:hidden;border-radius:18px 18px 0 0;">
                            <img src="@d.ReferenceImagePath" alt="@d.DiseaseName"
                                 style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                    }
                    else
                    {
                        <div style="width:100%;height:120px;background:linear-gradient(135deg,#e8f5e9,#c8e6c9);border-radius:18px 18px 0 0;display:flex;align-items:center;justify-content:center;font-size:4rem;">
                            🦠
                        </div>
                    }

                    <div style="padding:24px;">
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
                            <h4 style="font-weight:800;margin:0;">@d.DiseaseName</h4>
                            <span style="background:@severityBg;color:@severityColor;padding:4px 12px;border-radius:20px;font-size:0.78rem;font-weight:700;">
                                ⚠ @d.SeverityLevel
                            </span>
                        </div>
                        <div style="display:inline-block;background:#E8F5E9;color:#2e7d32;padding:4px 14px;border-radius:20px;font-size:0.82rem;font-weight:600;margin-bottom:20px;">
                            🌾 @d.CropName
                        </div>

                        @if (!string.IsNullOrEmpty(d.Symptoms))
                        {
                            <div style="margin-bottom:16px;">
                                <div style="font-weight:700;font-size:0.9rem;margin-bottom:6px;color:var(--text-dark,#1a1a1a);">🔍 Symptoms</div>
                                <p style="font-size:0.88rem;line-height:1.7;color:var(--text-gray);margin:0;background:#fafafa;padding:12px;border-radius:10px;border-left:4px solid #f59e0b;">@d.Symptoms</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(d.Solution))
                        {
                            <div style="margin-bottom:16px;">
                                <div style="font-weight:700;font-size:0.9rem;margin-bottom:6px;color:var(--text-dark,#1a1a1a);">💊 Solution / Treatment</div>
                                <p style="font-size:0.88rem;line-height:1.7;color:var(--text-gray);margin:0;background:#f0fdf4;padding:12px;border-radius:10px;border-left:4px solid #22c55e;">@d.Solution</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(d.RecommendedPesticide))
                        {
                            <div style="background:#ecfdf5;border-radius:12px;padding:14px 16px;display:flex;gap:10px;align-items:center;">
                                <span style="font-size:1.4rem;">🧪</span>
                                <div>
                                    <div style="font-size:0.76rem;color:#166534;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;">Recommended Pesticide</div>
                                    <div style="font-weight:700;font-size:0.95rem;color:#14532d;">@d.RecommendedPesticide</div>
                                </div>
                            </div>
                        }

                        <button onclick="closeDiseaseModal(@d.Id)"
                                class="btn-primary-green" style="width:100%;justify-content:center;padding:12px;margin-top:20px;">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .disease-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }
    .disease-modal-overlay {
        display: none;
    }
    .disease-modal-overlay.open {
        display: flex !important;
    }
</style>

<script>
    function openDiseaseModal(id) {
        document.getElementById('diseaseModal-' + id).classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeDiseaseModal(id) {
        document.getElementById('diseaseModal-' + id).classList.remove('open');
        document.body.style.overflow = '';
    }
    document.querySelectorAll('.disease-modal-overlay').forEach(function(overlay) {
        overlay.addEventListener('click', function(e) {
            if (e.target === overlay) {
                overlay.classList.remove('open');
                document.body.style.overflow = '';
            }
        });
    });
</script>
