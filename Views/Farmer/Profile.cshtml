@model Digital_Krushi_Officer.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    ViewData["ActiveMenu"] = "Profile";
    var u = Model.User;
    var fd = Model.FarmerDetails;
}
<div class="page-header d-flex justify-between align-center">
    <div><h1>👤 My Profile</h1><p>Your farming account details</p></div>
    <a href="/Farmer/EditProfile" class="btn-primary-green">✏ Edit Profile</a>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card p-4 text-center">
            <div style="width:80px;height:80px;background:linear-gradient(135deg,#2E7D32,#43A047);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2rem;color:white;margin:0 auto 16px;">👨‍🌾</div>
            <h4 style="font-weight:700;margin-bottom:4px;">@u?.Name</h4>
            <p style="color:var(--text-gray);margin-bottom:12px;">@u?.Role</p>
            <span class="badge @(u?.IsEmailVerified==true?"badge-green":"badge-yellow")">@(u?.IsEmailVerified==true?"✓ Email Verified":"Email Pending")</span>
            <div style="margin-top:16px;text-align:left;display:flex;flex-direction:column;gap:10px;">
                <div style="display:flex;gap:10px;align-items:center;"><span>📧</span><span style="font-size:0.875rem;">@u?.Email</span></div>
                <div style="display:flex;gap:10px;align-items:center;"><span>📱</span><span style="font-size:0.875rem;">@(u?.Mobile ?? "Not set")</span></div>
                <div style="display:flex;gap:10px;align-items:center;"><span>📍</span><span style="font-size:0.875rem;">@u?.Village, @u?.District, @u?.State</span></div>
                <div style="display:flex;gap:10px;align-items:center;"><span>🌐</span><span style="font-size:0.875rem;">@u?.PreferredLanguage</span></div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card p-4 mb-3">
            <h5 style="font-weight:700;margin-bottom:16px;">🌾 Farming Details</h5>
            <div class="grid-2">
                @{
                    void InfoBox(string icon, string label, string? val) {
                        <div style="background:#F8F9FA;border-radius:10px;padding:14px;">
                            <div style="font-size:0.72rem;color:var(--text-gray);font-weight:600;margin-bottom:4px;">@icon @label</div>
                            <div style="font-weight:700;font-size:0.95rem;">@(val ?? "Not set")</div>
                        </div>;
                    }
                }
                @{ InfoBox("🌱","Main Crop", fd?.MainCrop); }
                @{ InfoBox("📏","Land Area", fd?.LandArea != null ? $"{fd.LandArea} acres" : null); }
                @{ InfoBox("🌍","Soil Type", fd?.SoilType); }
                @{ InfoBox("📅","Experience", fd?.FarmingExperience != null ? $"{fd.FarmingExperience} years" : null); }
            </div>
        </div>
        <div class="card p-4">
            <h5 style="font-weight:700;margin-bottom:12px;">📅 Account Activity</h5>
            <div style="display:flex;flex-direction:column;gap:10px;">
                <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #F5F5F5;"><span style="color:var(--text-gray);">Member Since</span><span style="font-weight:600;">@u?.CreatedDate.ToString("dd MMM yyyy")</span></div>
                <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #F5F5F5;"><span style="color:var(--text-gray);">Last Login</span><span style="font-weight:600;">@(u?.LastLoginDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</span></div>
                <div style="display:flex;justify-content:space-between;padding:10px 0;"><span style="color:var(--text-gray);">Status</span><span class="badge badge-green">Active</span></div>
            </div>
        </div>
    </div>
</div>
