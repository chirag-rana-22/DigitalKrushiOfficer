@model Digital_Krushi_Officer.Models.TblEscalation
@{
    ViewData["Title"] = "Query Detail";
    ViewData["ActiveMenu"] = "Escalations";
    var farmer = Model.Query?.Farmer;
    var fd = farmer?.FarmerDetails;
}
<div class="page-header">
    <div class="breadcrumb"><a href="/Officer/Escalations" style="color:var(--green);text-decoration:none;">📨 Queries</a> → Query #@Model.Id</div>
    <h1>Query Detail #@Model.Id</h1>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- Farmer Query -->
        <div class="card mb-3">
            <div class="card-header-green"><span style="font-weight:700;">👨‍🌾 Farmer Query</span></div>
            <div style="padding:24px;">
                <div style="display:flex;gap:14px;align-items:flex-start;margin-bottom:16px;">
                    <div style="width:48px;height:48px;background:#E8F5E9;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;">
                        @(Model.Query?.QueryType=="Image"?"📷":Model.Query?.QueryType=="Voice"?"🎤":"💬")
                    </div>
                    <div>
                        <div style="font-weight:700;">@farmer?.Name</div>
                        <div style="color:var(--text-gray);font-size:0.82rem;">@farmer?.Mobile · @farmer?.District, @farmer?.Village</div>
                        <div style="font-size:0.78rem;color:var(--text-gray);">@Model.Query?.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                    </div>
                    <div style="margin-left:auto;display:flex;gap:6px;flex-wrap:wrap;">
                        <span class="badge @(Model.Priority=="Urgent"?"badge-red":Model.Priority=="High"?"badge-red":"badge-yellow")">@Model.Priority</span>
                        <span class="badge @(Model.Status=="Solved"?"badge-green":Model.Status=="InProgress"?"badge-blue":"badge-yellow")">@Model.Status</span>
                    </div>
                </div>
                @if(Model.Query != null) { <partial name="_QueryImages" model="Model.Query" /> }
                <div style="background:#F8F9FA;border-radius:10px;padding:16px;font-size:0.9rem;line-height:1.7;">
                    @Model.Query?.QueryText
                    @if (Model.Query?.CropContext != null) { <partial name="_CropContext" model="Model.Query.CropContext" /> }
                </div>
            </div>
        </div>

        <!-- AI Response -->
        @if (Model.Query?.AIResponse != null)
        {
            <div class="card mb-3">
                <div style="padding:20px;background:#E8F5E9;border-radius:var(--radius);">
                    <div style="font-size:0.72rem;font-weight:700;color:#2E7D32;margin-bottom:8px;">🤖 AI RESPONSE · Confidence: @Model.Query.AIResponse.ConfidenceScore%</div>
                    <div style="font-size:0.875rem;line-height:1.7;color:#424242;white-space:pre-wrap;">@Model.Query.AIResponse.AIAnswer</div>
                </div>
            </div>
        }

        <!-- Officer Reply Form -->
        @if (Model.Status == "Pending" || Model.Status == "InProgress")
        {
            <div class="card p-4">
                <h5 style="font-weight:700;margin-bottom:16px;">✍ Your Expert Reply</h5>
                <form asp-action="Reply" method="post" asp-antiforgery="true">

                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                    <input type="hidden" name="EscalationId" value="@Model.Id" />
                    <div class="form-group">
                        <label class="form-label">Reply to Farmer</label>
                        @Html.TextArea("OfficerReply", Model.OfficerReply, new { @class="form-control", rows=6, maxlength=16000, required="required", placeholder="Write your reply. If rejecting, explain why you cannot solve the query.", style="resize:vertical;" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Update Status</label>
                        @Html.DropDownList("Status", new[] {
                            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem("In Progress", "InProgress", Model.Status == "InProgress" || Model.Status == "Pending"),
                            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem("Mark as Solved", "Solved"),
                            new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem("Reject (Unable to solve)", "Rejected")
                        }, new { @class="form-control form-select" })
                    </div>
                    <div style="display:flex;gap:10px;">
                        <button type="submit" class="btn-primary-green" style="flex:1;justify-content:center;padding:13px;">📨 Send Reply to Farmer</button>
                        <a href="/Officer/Escalations" class="btn-outline-green" style="padding:13px 20px;text-decoration:none;">Cancel</a>
                    </div>
                </form>
            </div>
        }
        else if (Model.OfficerReply != null)
        {
            <div class="card p-4">
                <h5 style="font-weight:700;margin-bottom:12px;color:var(--green);">@(Model.Status == "Rejected" ? "Query rejected — reason sent" : "Your Reply (Sent)")</h5>
                <div style="background:#E8F5E9;border-radius:10px;padding:16px;font-size:0.875rem;line-height:1.7;">@Model.OfficerReply</div>
                @if (Model.ResolvedDate != null)
                {
                    <div style="margin-top:10px;color:var(--text-gray);font-size:0.8rem;">@(Model.Status == "Rejected" ? "Closed" : "Resolved"): @Model.ResolvedDate?.ToString("dd MMM yyyy, hh:mm tt")</div>
                }
            </div>
        }
    </div>

    <!-- Farmer Profile Sidebar -->
    <div class="col-lg-5">
        <div class="card p-4 mb-3">
            <h6 style="font-weight:700;margin-bottom:14px;">👨‍🌾 Farmer Profile</h6>
            <div style="display:flex;flex-direction:column;gap:10px;">
                @{
                    void InfoRow(string icon, string label, string? value) {
                        if (value != null) {
                            <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #F5F5F5;">
                                <span style="font-size:1rem;width:20px;">@icon</span>
                                <div>
                                    <div style="font-size:0.7rem;color:var(--text-gray);font-weight:600;">@label</div>
                                    <div style="font-size:0.875rem;font-weight:500;">@value</div>
                                </div>
                            </div>
                        }
                    }
                }
                @{ InfoRow("👤", "Name", farmer?.Name); }
                @{ InfoRow("📱", "Mobile", farmer?.Mobile); }
                @{ InfoRow("📍", "Location", $"{farmer?.Village}, {farmer?.District}, {farmer?.State}"); }
                @{ InfoRow("🌾", "Main Crop", fd?.MainCrop); }
                @{ InfoRow("📏", "Land Area", fd?.LandArea != null ? $"{fd.LandArea} acres" : null); }
                @{ InfoRow("🌱", "Soil Type", fd?.SoilType); }
                @{ InfoRow("📅", "Experience", fd?.FarmingExperience != null ? $"{fd.FarmingExperience} years" : null); }
            </div>
        </div>
        <div class="card p-4">
            <h6 style="font-weight:700;margin-bottom:12px;">⚡ Quick Actions</h6>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <a href="/Officer/Escalations?status=Pending" class="btn-outline-green" style="text-align:center;text-decoration:none;padding:10px;">📨 All Pending Queries</a>
                <a href="/Officer/Escalations?status=Solved" class="btn-outline-green" style="text-align:center;text-decoration:none;padding:10px;">✅ Solved Queries</a>
            </div>
        </div>
    </div>
</div>

<partial name="_OfficerConversationContext" model="(IReadOnlyList<Digital_Krushi_Officer.Models.TblQuery>)(ViewBag.ConversationContext ?? new List<Digital_Krushi_Officer.Models.TblQuery>())" />
