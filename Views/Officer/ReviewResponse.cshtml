@model TblAIResponse
@using Digital_Krushi_Officer.Models

@{
    ViewData["Title"] = "Review AI Response";
    var farmer = Model?.Query?.Farmer;
    var query = Model?.Query;
}

<div class="content-wrapper">
    <div class="review-detail-page">
        <!-- Header -->
        <div class="detail-header">
            <a href="/Officer/PendingReviews" class="back-btn">← Back to Reviews</a>
            <h1>Review & Approve AI Response</h1>
        </div>

        <div class="detail-container">
            <!-- Farmer Info Card -->
            <div class="info-card farmer-info">
                <h3>👨‍🌾 Farmer Details</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <label>Name:</label>
                        <strong>@farmer?.Name</strong>
                    </div>
                    <div class="info-item">
                        <label>Email:</label>
                        <strong>@farmer?.Email</strong>
                    </div>
                    <div class="info-item">
                        <label>Phone:</label>
                        <strong>@farmer?.Mobile</strong>
                    </div>
                    <div class="info-item">
                        <label>Location:</label>
                        <strong>@farmer?.District, @farmer?.State</strong>
                    </div>
                </div>
            </div>

            <!-- Query Info -->
            <div class="info-card query-info">
                <h3>❓ Farmer's Question</h3>
                <div class="query-text">@query?.QueryText</div>
                <div class="query-meta">
                    <small>Asked on: @query?.CreatedDate.ToString("dd MMM yyyy HH:mm")</small>
                </div>
            </div>

            <!-- AI Response Info -->
            <div class="info-card ai-info">
                <h3>🤖 AI Generated Response</h3>

                <div class="response-stats">
                    <div class="stat">
                        <span class="stat-label">Confidence Score</span>
                        <span class="stat-value">@(Model?.ConfidenceScore?.ToString("P0"))</span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Complexity Level</span>
                        <span class="stat-value">
                            @if (Model?.ComplexityLevel == ComplexityLevel.Complex)
                            {
                                <span class="badge-danger">🔴 Complex</span>
                            }
                            else if (Model?.ComplexityLevel == ComplexityLevel.Medium)
                            {
                                <span class="badge-warning">🟡 Medium</span>
                            }
                            else
                            {
                                <span class="badge-success">🟢 Simple</span>
                            }
                        </span>
                    </div>
                    <div class="stat">
                        <span class="stat-label">Response Time</span>
                        <span class="stat-value">@(Model?.ResponseTimeMs)ms</span>
                    </div>
                </div>

                <div class="ai-answer-full">
                    <h4>Full Answer:</h4>
                    <div class="answer-box">
                        @Html.Raw(Model?.AIAnswer?.Replace("\n", "<br>") ?? "No answer")
                    </div>
                </div>
            </div>

            <!-- Review Actions -->
            <div class="action-panel">
                <h3>✅ Your Review</h3>

                <!-- Approve -->
                <div class="action-section">
                    <h4>Approve As-Is</h4>
                    <p class="action-desc">Send the AI answer directly to the farmer without changes.</p>
                    <form method="post" action="/Officer/ApproveResponse"
                          onsubmit="return confirm('Approve this response?');">
                        <input type="hidden" name="id" value="@Model?.Id" />
                        <textarea name="officerNotes" placeholder="Optional: Add notes (visible to admin only)..."
                                  style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;margin-bottom:10px;"></textarea>
                        <button type="submit" class="btn btn-success">✅ Approve Response</button>
                    </form>
                </div>

                <!-- Modify -->
                <div class="action-section">
                    <h4>Edit & Approve</h4>
                    <p class="action-desc">Modify the AI answer before sending to the farmer.</p>
                    <form method="post" action="/Officer/ModifyAndApprove">
                        <input type="hidden" name="id" value="@Model?.Id" />
                        <textarea name="modifiedAnswer" required
                                  style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;margin-bottom:10px;min-height:150px;">@Model?.AIAnswer</textarea>
                        <textarea name="officerNotes" placeholder="What did you change and why?..."
                                  style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;margin-bottom:10px;"></textarea>
                        <button type="submit" class="btn btn-info">✏️ Modify & Approve</button>
                    </form>
                </div>

                <!-- Reject -->
                <div class="action-section">
                    <h4>Reject & Request New Answer</h4>
                    <p class="action-desc">Reject this answer and ask AI to generate a new one with better accuracy.</p>
                    <form method="post" action="/Officer/RejectResponse"
                          onsubmit="return confirm('Reject this response? AI will generate a new answer.');">
                        <input type="hidden" name="id" value="@Model?.Id" />
                        <textarea name="rejectionReason" required
                                  placeholder="Reason for rejection (e.g., 'Inaccurate disease identification', 'Incorrect dosage')..."
                                  style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;margin-bottom:10px;"></textarea>
                        <button type="submit" class="btn btn-danger">❌ Reject & Regenerate</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .review-detail-page {
        max-width: 1000px;
        margin: 0 auto;
    }

    .detail-header {
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid var(--green);
    }

    .back-btn {
        color: var(--green);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 12px;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        transform: translateX(-4px);
    }

    .detail-header h1 {
        color: var(--green);
        margin: 8px 0 0;
    }

    .detail-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .info-card {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 20px;
        transition: all 0.3s ease;
    }

    .info-card:hover {
        border-color: var(--green);
        box-shadow: 0 4px 12px rgba(34, 139, 34, 0.1);
    }

    .info-card h3 {
        margin-top: 0;
        margin-bottom: 16px;
        color: #333;
        font-size: 1.1rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .info-item label {
        display: block;
        font-weight: 600;
        color: #666;
        font-size: 0.85rem;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .info-item strong {
        display: block;
        color: #333;
        font-size: 1rem;
    }

    .query-text {
        background: #f9f9f9;
        padding: 12px;
        border-left: 4px solid var(--green);
        border-radius: 4px;
        margin-bottom: 12px;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .query-meta {
        color: #999;
    }

    .response-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
        padding: 16px;
        background: #f5f5f5;
        border-radius: 8px;
    }

    .stat {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-weight: 600;
        color: #666;
        font-size: 0.8rem;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .stat-value {
        color: var(--green);
        font-weight: 700;
        font-size: 1.1rem;
    }

    .badge-danger {
        background: #ffe0e0;
        color: #d32f2f;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        display: inline-block;
    }

    .badge-warning {
        background: #fff3cd;
        color: #856404;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        display: inline-block;
    }

    .badge-success {
        background: #d4edda;
        color: #155724;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        display: inline-block;
    }

    .ai-answer-full h4 {
        color: #333;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .answer-box {
        background: #f9f9f9;
        padding: 16px;
        border: 1px solid #ddd;
        border-radius: 8px;
        max-height: 300px;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .action-panel {
        background: white;
        border: 2px solid var(--green);
        border-radius: 12px;
        padding: 20px;
    }

    .action-panel h3 {
        margin-top: 0;
        margin-bottom: 20px;
        color: var(--green);
    }

    .action-section {
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }

    .action-section:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .action-section h4 {
        color: #333;
        margin-top: 0;
        margin-bottom: 4px;
    }

    .action-desc {
        color: #999;
        font-size: 0.9rem;
        margin-bottom: 12px;
    }

    .btn {
        padding: 12px 20px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        font-size: 0.95rem;
    }

    .btn-success {
        background: #28a745;
        color: white;
    }

    .btn-success:hover {
        background: #218838;
    }

    .btn-info {
        background: #17a2b8;
        color: white;
    }

    .btn-info:hover {
        background: #138496;
    }

    .btn-danger {
        background: #dc3545;
        color: white;
    }

    .btn-danger:hover {
        background: #c82333;
    }

    @@media(max-width: 768px) {
        .response-stats {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
