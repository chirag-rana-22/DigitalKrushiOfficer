@model Digital_Krushi_Officer.Models.ViewModels.EditProfileViewModel
@{ ViewData["Title"] = "Edit Profile"; ViewData["ActiveMenu"] = "Profile"; }
<div class="page-header"><h1>@Ui.Text("✏ Edit Profile")</h1></div>
<div class="card p-4" style="max-width:640px;">
    <form asp-action="EditProfile" method="post" asp-antiforgery="true">

        <h6 style="font-weight:700;color:var(--green);margin-bottom:14px;">@Ui.Text("👤 Personal Information")</h6>
        <div class="grid-2">
            <div class="form-group"><label class="form-label">@Ui.Text("Full Name")</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="validation-msg"></span></div>
            <div class="form-group"><label class="form-label">@Ui.Text("Mobile")</label><input asp-for="Mobile" class="form-control" /></div>
            <div class="form-group">
                <label class="form-label">@Ui.Text("🗺 State")</label>
                <input asp-for="State" class="form-control" value="Gujarat" readonly
                       style="background:rgba(255,255,255,0.05);color:var(--text-gray);cursor:not-allowed;opacity:0.8;" />
            </div>
            <div class="form-group">
                <label class="form-label">@Ui.Text("📍 District")</label>
                <select asp-for="District" id="op-district" class="form-control form-select">
                    <option value="">@Ui.Text("Loading...")</option>
                </select>
            </div>
        </div>
        <div class="form-group"><label asp-for="PreferredLanguage">@Ui.Text("Preferred Language")</label><select asp-for="PreferredLanguage" class="form-control form-select">@foreach (var language in Digital_Krushi_Officer.Services.SiteLanguage.Options) { <option value="@language.Name">@language.NativeName</option> }</select></div>
        <hr style="border-color:#E0E0E0;margin:16px 0;" />
        <h6 style="font-weight:700;color:var(--green);margin-bottom:14px;">@Ui.Text("💼 Professional Details")</h6>
        <div class="grid-2">
            <div class="form-group"><label class="form-label">@Ui.Text("Department")</label><input asp-for="Department" class="form-control" /></div>
            <div class="form-group"><label class="form-label">@Ui.Text("Designation")</label><input asp-for="Designation" class="form-control" /></div>
            <div class="form-group"><label class="form-label">@Ui.Text("Experience (years)")</label><input asp-for="ExperienceYears" type="number" class="form-control" /></div>
            <div class="form-group"><label class="form-label">@Ui.Text("Specialization")</label><input asp-for="Specialization" class="form-control" /></div>
        </div>
        <div style="display:flex;gap:10px;margin-top:8px;">
            <button type="submit" class="btn-primary-green" style="flex:1;justify-content:center;padding:13px;">@Ui.Text("💾 Save Changes")</button>
            <a href="/Officer/Profile" class="btn-outline-green" style="padding:13px 20px;text-decoration:none;">@Ui.Text("Cancel")</a>
        </div>
    </form>
</div>
@section Scripts {
<script src="/js/gujarat-location.js"></script>
<script>
const preDistrict = @Json.Serialize(Model?.District ?? "");
document.addEventListener('DOMContentLoaded', async function () {
    // Officer only needs District (no Village field in this form)
    const data = await fetch('/js/gujarat-locations.json').then(r => r.json());
    const sel = document.getElementById('op-district');
    const districts = Object.keys(data).sort();
    sel.innerHTML = '<option value="">-- Select District --</option>';
    districts.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d; opt.textContent = d;
        if (d === preDistrict) opt.selected = true;
        sel.appendChild(opt);
    });
});
</script>
}
