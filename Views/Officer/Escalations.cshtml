@model List<Digital_Krushi_Officer.Models.TblEscalation>
@{
    ViewData["Title"] = "Escalated Queries";
    ViewData["ActiveMenu"] = "Escalations";
    var statusFilter = ViewBag.StatusFilter as string;
}
<div class="page-header"><h1>📨 Escalated Queries</h1><p>Farmer queries forwarded for your expert advice</p></div>

<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;">
    <a href="/Officer/Escalations" class="@(statusFilter==null?"btn-primary-green":"btn-outline-green")" style="padding:8px 18px;text-decoration:none;font-size:0.85rem;">All</a>
    @foreach(var s in new[]{"Pending","InProgress","Solved","Rejected"})
    {
        <a href="/Officer/Escalations?status=@s" class="@(statusFilter==s?"btn-primary-green":"btn-outline-green")" style="padding:8px 18px;text-decoration:none;font-size:0.85rem;">@s</a>
    }
</div>

<div class="card">
    <div style="overflow-x:auto;">
        <table class="data-table">
            <thead><tr><th>#</th><th>Farmer</th><th>Query</th><th>Type</th><th>Priority</th><th>Status</th><th>Date</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td style="font-weight:700;color:var(--text-gray);">#@e.Id</td>
                        <td>
                            <div style="font-weight:600;">@e.Query?.Farmer?.Name</div>
                            <div style="font-size:0.75rem;color:var(--text-gray);">@e.Query?.Farmer?.Mobile · @e.Query?.Farmer?.District</div>
                        </td>
                        <td style="max-width:220px;">
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px;" title="@e.Query?.QueryText">
                                @(e.Query?.QueryText?.Length > 55 ? e.Query.QueryText[..55]+"..." : e.Query?.QueryText)
                            </div>
                            <div style="font-size:0.72rem;color:var(--text-gray);">@e.Query?.QueryType · @e.Query?.QueryLanguage</div>
                        </td>
                        <td><span style="font-size:1.1rem;">@(e.Query?.QueryType=="Image"?"📷":e.Query?.QueryType=="Voice"?"🎤":"💬")</span></td>
                        <td><span class="badge @(e.Priority=="Urgent"?"badge-red":e.Priority=="High"?"badge-red":e.Priority=="Medium"?"badge-yellow":"badge-gray")">@e.Priority</span></td>
                        <td><span class="badge @(e.Status=="Solved"?"badge-green":e.Status=="InProgress"?"badge-blue":e.Status=="Rejected"?"badge-red":"badge-yellow")">@e.Status</span></td>
                        <td style="font-size:0.8rem;color:var(--text-gray);">@e.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a href="/Officer/EscalationDetail/@e.Id" class="@(e.Status=="Pending"||e.Status=="InProgress"?"btn-primary-green":"btn-outline-green")" style="padding:6px 14px;font-size:0.78rem;text-decoration:none;display:inline-block;">
                                @(e.Status=="Pending"||e.Status=="InProgress"?"Reply →":"View")
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-gray);">No escalated queries found ✅</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
