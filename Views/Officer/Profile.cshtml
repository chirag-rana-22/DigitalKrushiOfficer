@model Digital_Krushi_Officer.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Officer Profile";
    ViewData["ActiveMenu"] = "Profile";
    var u = Model.User;
    var od = Model.OfficerDetails;
}
<div class="page-header d-flex justify-between align-center">
    <div><h1>@Ui.Text("👤 My Profile")</h1></div>
    <a href="/Officer/EditProfile" class="btn-primary-green">@Ui.Text("✏ Edit Profile")</a>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card p-4 text-center">
            <div style="width:80px;height:80px;background:linear-gradient(135deg,#2E7D32,#43A047);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2rem;color:white;margin:0 auto 16px;">👮</div>
            <h4 style="font-weight:700;margin-bottom:4px;">@u?.Name</h4>
            <p style="color:var(--text-gray);">@Ui.Text("Agriculture Officer")</p>
            <div style="margin-top:12px;text-align:left;display:flex;flex-direction:column;gap:8px;">
                <div style="display:flex;gap:10px;"><span>📧</span><span style="font-size:0.875rem;">@u?.Email</span></div>
                <div style="display:flex;gap:10px;"><span>📱</span><span style="font-size:0.875rem;">@(u?.Mobile ?? "Not set")</span></div>
                <div style="display:flex;gap:10px;"><span>📍</span><span style="font-size:0.875rem;">@u?.District, @u?.State</span></div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card p-4">
            <h5 style="font-weight:700;margin-bottom:16px;">@Ui.Text("💼 Professional Details")</h5>
            <div class="grid-2">
                @{
                    void InfoBox(string icon, string label, string? val) {
                        <div style="background:#F8F9FA;border-radius:10px;padding:14px;">
                            <div style="font-size:0.72rem;color:var(--text-gray);font-weight:600;">@icon @Ui.Text(label)</div>
                            <div style="font-weight:700;margin-top:3px;">@(val ?? Ui.Text("Not set"))</div>
                        </div>;
                    }
                }
                @{ InfoBox("🏛","Department", od?.Department); }
                @{ InfoBox("👔","Designation", od?.Designation); }
                @{ InfoBox("📅","Experience", od?.ExperienceYears != null ? $"{od.ExperienceYears} years" : null); }
                @{ InfoBox("🌾","Specialization", od?.Specialization); }
            </div>
        </div>
    </div>
</div>
